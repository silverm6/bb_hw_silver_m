{
  "name": "dragons-cli",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "bun run lint && bun run fmt && bun run typecheck",
    "fix": "bun run lint:fix && bun run fmt:fix"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
