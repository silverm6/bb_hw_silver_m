{
  "name": "dragons-cli",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run fmt && bun run typecheck && bun test",
    "fix": "bun run lint:fix && bun run fmt:fix"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "dragons-api": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  }
}
