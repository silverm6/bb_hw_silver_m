{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "plugins": ["react", "react-perf"],
  "categories": {
    "perf": "warn"
  },
  "env": {
    "browser": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "warn",
    "react/react-in-jsx-scope": "off"
  }
}
